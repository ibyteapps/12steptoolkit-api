APP_NAME="12 Step Toolkit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.12steptoolkit.com
APP_TIMEZONE=UTC

# Plesk/NGINX sits in front. Narrow this to the proxy's own address.
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stack
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# The database
#
# This application ADOPTS the existing database. It adds tables; it never alters
# one that was already there. The user it connects as needs CREATE on the new
# tables and the usual rights on the old ones — it does not need ALTER on them.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=data_12steptoolkit
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@12steptoolkit.com
MAIL_FROM_NAME="12 Step Toolkit"

# ---------------------------------------------------------------------------
# The legacy compatibility layer
#
# LEGACY_JWT_SECRET is the HS256 secret the shipped Android and Flutter builds'
# tokens are signed with. It is in `19/jwt_verify.php` on the server. Tokens
# already in the field were signed with it, so it has to be accepted until
# those installs are gone — and it should be rotated the day they are.
#
# LEGACY_SERVER_SECRET is the Apple shared secret. It is compiled into every
# App Store build and is printed in `8/test.html`, so it proves nothing. Read
# the long note at the top of config/legacy.php before switching the Apple
# layer on.
# ---------------------------------------------------------------------------
LEGACY_V19_ENABLED=true
LEGACY_JWT_SECRET=
LEGACY_JWT_ISSUER=12steptoolkit
LEGACY_HMAC_WINDOW=300
LEGACY_NONCE_RETENTION=3600

# Off until the v8 endpoints exist. Turning it on before then would answer an
# empty 200 to every iOS request, which looks like a working cutover and is not.
LEGACY_V8_ENABLED=false
LEGACY_SERVER_SECRET=

LEGACY_SEAL_ON_V2_LOGIN=true

# The live server's JWT secret is the firebase/php-jwt template placeholder, so
# anybody can mint a legacy token for any account. This application never issues
# that format, and refuses to register a device or rotate a signing key for one.
# Set true only if that turns out to break more real installs than expected
# during the cutover window. See docs/OPEN_QUESTIONS.md B0.
LEGACY_TOKENS_MAY_BOOTSTRAP=false
LEGACY_PLAINTEXT_PASSWORD=keep
# The old, broken Google sign-in: an email address and nothing else. Leave off.
LEGACY_SOCIAL_EMAIL_MATCH=false

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
TOKEN_TTL_DAYS=60
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.12stepapp.recoverybox

# ---------------------------------------------------------------------------
# Subscriptions
#
# Paths, never keys: the Apple .p8 and the Play service-account JSON live
# outside the web root, chmod 600.
# ---------------------------------------------------------------------------
APPLE_BUNDLE_ID=com.12stepapp.recoverybox
APPLE_APP_APPLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Only if the key that reads the CATALOGUE is a different one. An In-App
# Purchase key cannot read the App Store Connect API; a Team key can read both.
# Left empty, the three above are used. docs/STORE_SETUP.md §1.
APPLE_CONNECT_ISSUER_ID=
APPLE_CONNECT_KEY_ID=
APPLE_CONNECT_KEY_PATH=

APPLE_STORE_ENVIRONMENT=production
APPLE_ACCEPT_SANDBOX=true
APPLE_NOTIFICATIONS_FORWARD_URL=

GOOGLE_PACKAGE_NAME=com.ibyteapps.aa12steptoolkit
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_AUDIENCE=

# Read-only, for the overlap while the old apps are still installed.
#
# Two flags, and the ORDER between them is the whole point: set
# REVENUECAT_GRANTS_ACCESS=false only once the export has been imported and
# checked, and REVENUECAT_ENABLED=false only once 1.9.0 and 1.6.6 are retired.
# Both false too early silently un-subscribes everybody not yet imported.
# docs/ENTITLEMENT_RULES.md §0.
REVENUECAT_ENABLED=true
REVENUECAT_GRANTS_ACCESS=true
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=subscribed

# ---------------------------------------------------------------------------
# Backup
#
# D-001: free for everyone. The switch exists so that changing that would be a
# deliberate act rather than an `if` somebody adds to a controller.
# ---------------------------------------------------------------------------
SYNC_NEEDS_SUBSCRIPTION=false

# Profile pictures, kept outside the web root as the PHP scripts keep them.
ICONS_PATH=/var/www/vhosts/ibyteserver.com/ICONS/12steptoolkit.com

CORS_ALLOWED_ORIGINS=https://12steptoolkit.com
